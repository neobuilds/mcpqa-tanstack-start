# TanStack Taskboard — environment configuration
#
# Copy this file to `.env` (or export these variables in your shell) to
# override the defaults. The production server reads these at startup.
# All values shown are the built-in defaults.

# TCP port the production server binds to.
PORT=3000

# Host/interface the production server binds to.
HOST=0.0.0.0

# Filesystem path to the SQLite database file (persists across restarts).
# Relative paths are resolved against the process working directory.
DATABASE_PATH=./data/taskboard.db

# Optional: disable the experimental SQLite warning on Node 22 by setting
# NODE_OPTIONS specially if you need it; no application setting required.
# NODE_OPTIONS=--no-warnings